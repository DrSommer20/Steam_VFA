# Steam Web API Key -> https://steamcommunity.com/dev/apikey
STEAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pfad zur SQLite-Datenbank
# (im Docker-Betrieb egal - docker-compose.yml setzt /data/steamhub.db)
DB_PATH=data/steamhub.db

# Spielerliste (wird per "python -m app.cli add <profil-url>" gepflegt)
PLAYERS_FILE=data/players.json

# Sprache der Store-Metadaten (de/en)
STORE_LANG=german
STORE_CC=DE

# Wie viele Spiele pro Spieler maximal auf Achievements geprueft werden
ACH_TOP_GAMES=40
# Achievements erst nach X Stunden erneut abfragen, wenn keine Spielzeit dazukam
ACH_REFRESH_HOURS=168

# Token fuer schreibende Zugriffe: /api/collect ausloesen und die Discord-Routen.
# Der Bot braucht es zwingend. Leer = alles davon deaktiviert.
ADMIN_TOKEN=

# Server
HOST=127.0.0.1
PORT=8077

# ---------------------------------------------------------------- Discord

# 1) Meldungen aus dem Sammellauf (seltene Achievements, 100 %, Neuzugaenge,
#    Wochenrueckblick). Discord: Kanal -> Bearbeiten -> Integrationen -> Webhooks.
#    Leer = keine Meldungen.
DISCORD_WEBHOOK_URL=

# Ab welcher Weltweit-Quote gilt eine Errungenschaft als selten?
NOTIFY_RARE_PCT=5
# Wochenrueckblick: 0=Montag ... 6=Sonntag, und ab welcher vollen Stunde
NOTIFY_WEEKLY_DAY=6
NOTIFY_WEEKLY_HOUR=18
# Ab wann gilt ein Spiel als Staubfaenger (Tage ohne Start)
NOTIFY_DORMANT_DAYS=90

# 2) Der Bot (eigener Container, Start mit: docker compose --profile bot up -d)
#    Token: https://discord.com/developers/applications -> Bot -> Reset Token
#    Dort ausserdem "Server Members Intent" aktivieren.
DISCORD_TOKEN=
# Server-ID (Rechtsklick auf den Server -> ID kopieren, Entwicklermodus an).
# Gesetzt = Slash-Befehle sind sofort da, leer = global, bis zu einer Stunde Wartezeit.
DISCORD_GUILD_ID=
# Kanal-ID fuer die automatischen Voice-Vorschlaege.
# Leer = der Bot antwortet im Sprachkanal selbst.
DISCORD_CHANNEL_ID=
# Wie erreicht der Bot den Hub? Im Compose-Netz uebernimmt das die compose-Datei.
HUB_URL=http://127.0.0.1:8077
# Oeffentliche Adresse des Hubs - erscheint als Fusszeile unter den Meldungen.
PUBLIC_URL=
# Ab wie vielen verknuepften Leuten im Sprachkanal schlaegt der Bot etwas vor,
# und wie lange gibt er danach Ruhe (Minuten)?
VOICE_MIN_PLAYERS=2
VOICE_COOLDOWN_MIN=180
